# Copy to .env and override as needed.
# Dev defaults require NO external services:
#   SQLite database, in-process (eager) task queue, local-filesystem object storage.

# --- Database ---
DATABASE_URL=sqlite:///./dev.db
# Prod-shaped:
# DATABASE_URL=postgresql+psycopg://invoice_ops:invoice_ops@localhost:5432/invoice_ops
SQL_ECHO=false

# --- Task queue ---
CELERY_TASK_ALWAYS_EAGER=true
# Prod-shaped:
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Object storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./_storage
# Prod-shaped (MinIO / S3):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=invoice-ops

APP_ENV=dev
